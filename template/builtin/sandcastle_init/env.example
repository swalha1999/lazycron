# Claude authentication — pick ONE of the two env-var mechanisms below.
# Lazycron passes whichever you set into the sandbox via agentSandboxConfig().

# 1) Anthropic API key (pay-per-token).
ANTHROPIC_API_KEY=

# 2) Claude subscription OAuth token (use your subscription instead of API).
# Sandcastle issue 191 has token-extraction instructions:
# https://github.com/mattpocock/sandcastle/issues/191
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub personal access token (used by `gh` CLI inside the sandbox and on the host)
GH_TOKEN=

# Repo to clone for per-run worktrees (HTTPS or SSH URL)
REPO_URL=
