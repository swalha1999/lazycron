# Anthropic API key (used by Claude Code inside the sandbox).
# Either set ANTHROPIC_API_KEY here OR use Claude subscription OAuth — see
# https://github.com/mattpocock/sandcastle/issues/191 for the OAuth setup.
# Lazycron does not enforce either at the host level; sandcastle/Claude Code
# handle auth validation themselves.
ANTHROPIC_API_KEY=

# GitHub personal access token (used by `gh` CLI inside the sandbox and on the host)
GH_TOKEN=

# Repo to clone for per-run worktrees (HTTPS or SSH URL)
REPO_URL=
