# Anthropic API key
# If you want to use your Claude subscription instead of an API key,
# see https://github.com/mattpocock/sandcastle/issues/191
ANTHROPIC_API_KEY=

# GitHub personal access token (used by `gh` CLI inside the sandbox and on the host)
GH_TOKEN=

# Repo to clone for per-run worktrees (HTTPS or SSH URL)
REPO_URL=
